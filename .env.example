# Copy to .env and adjust. Never commit .env.
# Values below work for local development (`pnpm dev`) with postgres from docker compose.

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=info                     # fatal | error | warn | info | debug | trace | silent

# ---------- PostgreSQL (docker compose) ----------
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail_dev_password
POSTGRES_DB=retailchain
POSTGRES_PORT=5432

# ---------- API (apps/api) ----------
API_PORT=3000
# Local dev connects to localhost; docker compose overrides the host to "postgres".
DATABASE_URL=postgresql://retail:retail_dev_password@localhost:5432/retailchain?schema=public
# Comma-separated origins allowed by CORS (admin + pos).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT: access token 15 minutes + refresh token. Use long random strings (>= 32 chars) in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- External integrations (adapter pattern) ----------
# mock = built-in fake adapter (default). real = provider adapter, needs the provider variables below.
PAYMENT_ADAPTER=mock
EINVOICE_ADAPTER=mock
SMS_ADAPTER=mock
# Provider credentials (only read when the adapter is "real"; filled in by the sprint that adds them).
PAYMENT_QR_API_URL=
PAYMENT_QR_API_KEY=
EINVOICE_API_URL=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=
SMS_API_URL=
SMS_API_KEY=

# ---------- Frontends (apps/admin, apps/pos) ----------
# URL the BROWSER uses to reach the API (baked in at build time).
VITE_API_URL=http://localhost:3000
ADMIN_PORT=5173
POS_PORT=5174
