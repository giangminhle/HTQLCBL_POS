# apps/api local development. Copy to .env and fill in the password.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
DATABASE_URL=postgresql://retailchain:CHANGE_ME@localhost:5432/retailchain_dev?schema=public
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
# Refresh token lifetime (ADR-001): admin web and OWNER 7 days; POS app (CASHIER, BRANCH_MANAGER) 30 days.
JWT_REFRESH_TTL_ADMIN=7d
JWT_REFRESH_TTL_POS=30d

PAYMENT_ADAPTER=mock
EINVOICE_ADAPTER=mock
SMS_ADAPTER=mock
