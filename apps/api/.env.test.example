# apps/api E2E tests. Copy to .env.test and fill in the password.
# The database name MUST end with _test: the schema is reset before every E2E run.
NODE_ENV=test
LOG_LEVEL=silent
DATABASE_URL=postgresql://retailchain:CHANGE_ME@localhost:5432/retailchain_test?schema=public
JWT_ACCESS_SECRET=test-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=test-refresh-secret-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_ADMIN=7d
JWT_REFRESH_TTL_POS=30d
