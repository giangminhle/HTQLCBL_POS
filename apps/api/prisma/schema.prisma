generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Infrastructure-only key/value table (e.g. seed version).
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ---------- branches module (REQ-BR-01) ----------

enum BranchType {
  STORE
  WAREHOUSE
}

model Branch {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(20)
  name      String     @db.VarChar(100)
  address   String?    @db.VarChar(255)
  type      BranchType
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users     User[]
  auditLogs AuditLog[]

  @@map("branches")
}

// ---------- users module (REQ-AUTH-01, REQ-AUTH-02) ----------

enum Role {
  OWNER
  BRANCH_MANAGER
  CASHIER
  WAREHOUSE_KEEPER
  ACCOUNTANT
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(50)
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name") @db.VarChar(100)
  role               Role
  /// NULL only for OWNER (enforced in UsersService).
  branchId           String?   @map("branch_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  /// Consecutive failed logins; reset on success, on lock, and on password reset.
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at")
  /// Set for new users and after a password reset: only change-password and logout are allowed.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// Embedded in tokens; incrementing it revokes every access and refresh token of the user.
  tokenVersion       Int       @default(0) @map("token_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  branch        Branch?        @relation(fields: [branchId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([branchId])
  @@map("users")
}

// ---------- auth module ----------

enum AuthClient {
  ADMIN
  POS
}

model RefreshToken {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  /// SHA-256 of the token. The raw token is never stored.
  tokenHash    String     @unique @map("token_hash") @db.Char(64)
  client       AuthClient
  /// User.tokenVersion at issue time; a mismatch means the session was revoked.
  tokenVersion Int        @map("token_version")
  expiresAt    DateTime   @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  replacedById String?    @map("replaced_by_id") @db.Uuid
  userAgent    String?    @map("user_agent") @db.VarChar(255)
  ip           String?    @db.VarChar(64)
  createdAt    DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- audit module (REQ-AUD-01) ----------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  /// Snapshot of the actor's username (kept even if the user is renamed or deactivated).
  username  String?  @db.VarChar(50)
  /// Branch the record belongs to; BRANCH_MANAGER sees only logs of their branch.
  branchId  String?  @map("branch_id") @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(64)
  requestId String?  @map("request_id") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
