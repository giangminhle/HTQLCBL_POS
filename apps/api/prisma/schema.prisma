generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Infrastructure-only key/value table (e.g. seed version).
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ---------- branches module (REQ-BR-01) ----------

enum BranchType {
  STORE
  WAREHOUSE
}

model Branch {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(20)
  name      String     @db.VarChar(100)
  address   String?    @db.VarChar(255)
  type      BranchType
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users      User[]
  auditLogs  AuditLog[]
  priceLists PriceList[]

  @@map("branches")
}

// ---------- users module (REQ-AUTH-01, REQ-AUTH-02) ----------

enum Role {
  OWNER
  BRANCH_MANAGER
  CASHIER
  WAREHOUSE_KEEPER
  ACCOUNTANT
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(50)
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name") @db.VarChar(100)
  role               Role
  /// NULL only for OWNER (enforced in UsersService).
  branchId           String?   @map("branch_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  /// Consecutive failed logins; reset on success, on lock, and on password reset.
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at")
  /// Set for new users and after a password reset: only change-password and logout are allowed.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// Embedded in tokens; incrementing it revokes every access and refresh token of the user.
  tokenVersion       Int       @default(0) @map("token_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  branch        Branch?        @relation(fields: [branchId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([branchId])
  @@map("users")
}

// ---------- auth module ----------

enum AuthClient {
  ADMIN
  POS
}

model RefreshToken {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  /// SHA-256 of the token. The raw token is never stored.
  tokenHash    String     @unique @map("token_hash") @db.Char(64)
  client       AuthClient
  /// User.tokenVersion at issue time; a mismatch means the session was revoked.
  tokenVersion Int        @map("token_version")
  expiresAt    DateTime   @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  replacedById String?    @map("replaced_by_id") @db.Uuid
  userAgent    String?    @map("user_agent") @db.VarChar(255)
  ip           String?    @db.VarChar(64)
  createdAt    DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- audit module (REQ-AUD-01) ----------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  /// Snapshot of the actor's username (kept even if the user is renamed or deactivated).
  username  String?  @db.VarChar(50)
  /// Branch the record belongs to; BRANCH_MANAGER sees only logs of their branch.
  branchId  String?  @map("branch_id") @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(64)
  requestId String?  @map("request_id") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------- products module (REQ-PRD-01) ----------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  parentId  String?  @map("parent_id") @db.Uuid
  /// Materialised path of ancestor ids incl. self: "/<root>/<child>/". Subtree = path LIKE '<path>%'.
  path      String   @db.VarChar(1000)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([path])
  @@index([updatedAt])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  sku          String   @unique @db.VarChar(40)
  name         String   @db.VarChar(150)
  /// Lower-case, diacritics removed (normalizeSearch) for "sua" → "Sữa".
  searchText   String   @map("search_text") @db.VarChar(400)
  categoryId   String?  @map("category_id") @db.Uuid
  unit         String   @db.VarChar(20)
  /// VND (integer đồng).
  defaultPrice Int      @map("default_price")
  costPrice    Int      @default(0) @map("cost_price")
  minStock     Int      @default(0) @map("min_stock")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@index([categoryId])
  @@index([searchText])
  @@index([updatedAt])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String   @unique @db.VarChar(40)
  name       String   @db.VarChar(150)
  searchText String   @map("search_text") @db.VarChar(400)
  /// e.g. {"size":"400ml","màu":"Hồng"}
  attributes Json     @default("{}")
  /// CR-004: null → product.defaultPrice / costPrice / minStock.
  price      Int?
  costPrice  Int?     @map("cost_price")
  minStock   Int?     @map("min_stock")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id])
  barcodes       Barcode[]
  priceListItems PriceListItem[]

  @@index([productId])
  @@index([updatedAt])
  @@map("product_variants")
}

model Barcode {
  id        String    @id @default(uuid()) @db.Uuid
  variantId String    @map("variant_id") @db.Uuid
  code      String    @db.VarChar(32)
  /// Soft delete so /sync/catalog can tell the POS to drop the code.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([updatedAt])
  @@map("barcodes")
}

// ---------- inventory module (REQ-INV-01..04) ----------

enum StockMovementType {
  IMPORT
  SALE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(100)
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  goodsReceipts GoodsReceipt[]

  @@map("suppliers")
}

model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  branchId  String            @map("branch_id") @db.Uuid
  variantId String            @map("variant_id") @db.Uuid
  type      StockMovementType
  /// Signed: positive for inbound, negative for outbound.
  quantity  Int
  /// Source document type, e.g. "GoodsReceipt", "StockTransfer", "StockCount", "Sale".
  refType   String?           @map("ref_type") @db.VarChar(50)
  /// Source document id.
  refId     String?           @map("ref_id") @db.Uuid
  createdBy String            @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([branchId, variantId, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

/// Cache of current stock per branch+variant. Updated in the same transaction as StockMovement.
model StockBalance {
  branchId  String   @map("branch_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([branchId, variantId])
  @@index([branchId])
  @@map("stock_balances")
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
}

model GoodsReceipt {
  id         String              @id @default(uuid()) @db.Uuid
  code       String              @unique @db.VarChar(30)
  supplierId String              @map("supplier_id") @db.Uuid
  branchId   String              @map("branch_id") @db.Uuid
  note       String?             @db.VarChar(500)
  status     GoodsReceiptStatus  @default(DRAFT)
  createdBy  String              @map("created_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  supplier Supplier           @relation(fields: [supplierId], references: [id])
  items    GoodsReceiptItem[]

  @@index([branchId])
  @@index([supplierId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id        String @id @default(uuid()) @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  quantity  Int
  /// VND per unit at time of receipt.
  unitCost  Int    @map("unit_cost")

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id])

  @@index([receiptId])
  @@map("goods_receipt_items")
}

enum StockTransferStatus {
  DRAFT
  SENT
  RECEIVED
}

model StockTransfer {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique @db.VarChar(30)
  fromBranchId String              @map("from_branch_id") @db.Uuid
  toBranchId   String              @map("to_branch_id") @db.Uuid
  note         String?             @db.VarChar(500)
  status       StockTransferStatus @default(DRAFT)
  sentBy       String?             @map("sent_by") @db.Uuid
  sentAt       DateTime?           @map("sent_at")
  receivedBy   String?             @map("received_by") @db.Uuid
  receivedAt   DateTime?           @map("received_at")
  createdBy    String              @map("created_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  items StockTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String @id @default(uuid()) @db.Uuid
  transferId       String @map("transfer_id") @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  sentQuantity     Int    @map("sent_quantity")
  /// Set when RECEIVED. May differ from sentQuantity (shortage on receive).
  receivedQuantity Int?   @map("received_quantity")

  transfer StockTransfer @relation(fields: [transferId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

enum StockCountStatus {
  DRAFT
  COMPLETED
}

model StockCount {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(30)
  branchId    String           @map("branch_id") @db.Uuid
  note        String?          @db.VarChar(500)
  status      StockCountStatus @default(DRAFT)
  createdBy   String           @map("created_by") @db.Uuid
  completedBy String?          @map("completed_by") @db.Uuid
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  items StockCountItem[]

  @@index([branchId])
  @@map("stock_counts")
}

model StockCountItem {
  id             String @id @default(uuid()) @db.Uuid
  countId        String @map("count_id") @db.Uuid
  variantId      String @map("variant_id") @db.Uuid
  /// System stock at the time the count was created.
  systemQuantity Int    @map("system_quantity")
  /// Actual count entered by the user.
  actualQuantity Int?   @map("actual_quantity")

  count StockCount @relation(fields: [countId], references: [id])

  @@index([countId])
  @@map("stock_count_items")
}

// ---------- pricing module (REQ-PRC-01) ----------

model PriceList {
  id            String    @id @default(uuid()) @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  name          String    @db.VarChar(100)
  /// Half-open [effectiveFrom, effectiveTo); null end = open-ended. No overlap per branch (exclusion constraint).
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(3)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  branch Branch          @relation(fields: [branchId], references: [id])
  items  PriceListItem[]

  @@index([branchId, effectiveFrom])
  @@index([updatedAt])
  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(uuid()) @db.Uuid
  priceListId String    @map("price_list_id") @db.Uuid
  variantId   String    @map("variant_id") @db.Uuid
  /// VND (integer đồng).
  price       Int
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  priceList PriceList      @relation(fields: [priceListId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([priceListId, variantId])
  @@index([variantId])
  @@index([updatedAt])
  @@map("price_list_items")
}
